# Copy to .env and fill in. .env is gitignored; never commit the real one.
#
# Only the retrieval stage reads any of this. The router works with no .env at all.
# Ordered the way you will need them: the two tokens that apply migrations first,
# then the two the indexer and search use, then the embedding model.

# ---------------------------------------------------------------- migrations --
# bin/db.mjs applies migrations through Supabase's Management API, so it needs a
# personal access token rather than a project key. Create one under Account
# Settings > Access Tokens. The project ref is the subdomain of your project URL:
# https://<project-ref>.supabase.co
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ------------------------------------------------------- indexer and search --
# Project URL and the service key. Settings > API in the dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co

# The service_role key, not anon. It bypasses row level security, which is the
# point: the schema ships with RLS on and no policies, so anything holding only
# the publishable key reads nothing. That means this key stays on your machine and
# never goes near a browser, a published page or a committed file.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Nothing here needs a direct Postgres connection today: writes go
# through the REST API, which is fast enough at this corpus size. Only fill this
# in if you move bulk upserts to direct SQL. The dashboard's Connect button, not
# Settings > Database.
SUPABASE_DB_URL=

# ------------------------------------------------------------------ embedding --
# local (Ollama) or voyage.
#
# Local is the default and the recommended one. No key, no rate limit, no text
# leaving the machine, and mxbai-embed-large returns 1024 dimensions so it matches
# the schema with no migration.
#
#   ollama pull mxbai-embed-large
#
# Ollama has to be running whenever a search runs, not only when indexing: a query
# is embedded by the same model that embedded the corpus, and vectors are only
# comparable to vectors from the same model. Changing either variable below means
# re-running the indexer with --rebuild.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSIONS=1024

# Only if Ollama is not on the default port, or is on another machine.
# OLLAMA_HOST=http://127.0.0.1:11434

# Read only when EMBEDDING_PROVIDER=voyage. A free Voyage account is throttled
# hard enough to turn a five minute index into an overnight one, so check your
# limits before choosing this over local.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-large
