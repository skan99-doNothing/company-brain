{
  "name": "company-brain",
  "version": "1.0.0",
  "description": "A router and memory layer for AI coding sessions spread across many folders. One place to open Claude from, one ledger per department, nothing moved.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "init": "node bin/init.mjs",
    "sync": "node bin/sync-inventory.mjs",
    "doctor": "node bin/doctor.mjs",
    "doctor:deep": "node bin/doctor.mjs --deep",
    "atlas": "node bin/serve-atlas.mjs",
    "preflight": "node bin/preflight.mjs",
    "index": "node bin/index.mjs",
    "search": "node bin/search.mjs",
    "eval": "node bin/eval-search.mjs",
    "supervise": "node bin/supervise.mjs",
    "brain": "node bin/mcp-brain.mjs",
    "entities": "node bin/entities.mjs",
    "relate": "node bin/relate.mjs",
    "db": "node bin/db.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "second-brain",
    "obsidian",
    "agents",
    "mcp",
    "skills",
    "context-engineering",
    "rag",
    "pgvector"
  ],
  "files": [
    "bin",
    "templates",
    "atlas",
    ".claude",
    "org.config.json",
    "CLAUDE.md"
  ]
}
